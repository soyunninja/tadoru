# Copy to /etc/tadoru/tadoru.env, then: sudo chmod 600 /etc/tadoru/tadoru.env
#
# Generate the password with:  openssl rand -base64 24
# The service refuses to start if this is missing or left at the example value.
TADORU_ADMIN_PASSWORD=change-me

# Domains to measure, comma-separated. Anything else is silently ignored.
TADORU_SITES=example.com,myproject.dev

# Bind address and port. Keep it on localhost and put a reverse proxy in front.
TADORU_HOST=127.0.0.1
TADORU_PORT=3000

# Set to true ONLY when a reverse proxy sits in front. Trusting X-Forwarded-For
# without one lets anyone spoof their country.
TADORU_TRUSTED_PROXY=true
